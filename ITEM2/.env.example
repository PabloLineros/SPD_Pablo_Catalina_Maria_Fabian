# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - NORTISHOP (ITEM II)
# ==============================================================================
# Esta plantilla NO contiene secretos. Para crear su .env local con llaves aleatorias:
#
#     npm run generar-env
#
# El script crea/completa .env sin sobrescribir valores existentes. .env está en .gitignore.
# ==============================================================================

NODE_ENV=development

# Factor de costo bcrypt (OWASP: 10 a 14). Validado entre 10 y 16.
BCRYPT_SALT_ROUNDS=12

# Duración de la sesión en minutos.
SESSION_TTL_MINUTOS=30

# Mostrar los registros de actividad (ya redactados) en consola.
LOG_A_CONSOLA=false

# LLAVES CRIPTOGRÁFICAS: una por finalidad, 32 bytes aleatorios en hexadecimal (64 caracteres).
# Deben ser todas distintas. NO copie valores de ejemplo: use npm run generar-env.
KEY_CIFRADO_AES256=
KEY_HMAC_INTEGRIDAD=
KEY_HMAC_INDICE=
KEY_HMAC_RESENAS=
KEY_HMAC_ANALITICA=
KEY_HMAC_MARKETING=
KEY_HMAC_AUDITORIA=
KEY_HMAC_VERIFICACION=
