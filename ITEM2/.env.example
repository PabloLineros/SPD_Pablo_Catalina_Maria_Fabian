# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE SEGURIDAD - NORTISHOP (ITEM II)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo como '.env': cp .env.example .env
# 2. Reemplace los valores de ejemplo con secretos criptográficamente seguros.
# 3. NUNCA incluya el archivo '.env' en el control de versiones (Git).
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000

# LLAVE DE CIFRADO SIMÉTRICO AES-256 (PII: Email, Dirección, Facturación)
# Debe ser exactamente de 32 bytes (256 bits) codificada en hexadecimal (64 caracteres hex).
# Puede generar una llave segura ejecutando en Node.js: crypto.randomBytes(32).toString('hex')
ENCRYPTION_KEY_AES256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LLAVE SECRETA PARA CÓDIGO DE INTEGRIDAD HMAC-SHA256 (Saldos y NortiPuntos)
# Clave simétrica de al menos 32 bytes para prevenir manipulación no autorizada.
HMAC_SECRET_KEY=nortishop_hmac_super_secret_integrity_key_2026_secure!

# FACTOR DE COSTO PARA HASHING DE CONTRASEÑAS (bcrypt salt rounds)
# Recomendado entre 10 y 14 según OWASP para equilibrar seguridad y tiempo de cómputo.
BCRYPT_SALT_ROUNDS=12

# CONFIGURACIÓN DEL VAULT EXTERNO / PASARELA DE PAGOS (Simulador PCI-DSS)
PAYMENT_GATEWAY_API_KEY=gw_live_sk_948f21e0ab93c87e41258d4619
