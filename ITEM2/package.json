{
  "name": "nortishop-security-item2",
  "version": "2.0.0",
  "description": "Minimización, seudonimización, RBAC y controles criptográficos para la protección de datos personales en NortiShop",
  "main": "src/api.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/demo.js",
    "demo:privacidad": "node src/demo-privacidad.js",
    "test": "node --import ./scripts/entorno-pruebas.js --test",
    "generar-env": "node scripts/generar-env.js",
    "matriz": "node scripts/matriz-rbac.js",
    "servidor": "node src/server.js"
  },
  "keywords": [
    "cybersecurity",
    "cryptography",
    "aes-256-gcm",
    "bcrypt",
    "tokenization",
    "hmac",
    "rbac",
    "pseudonymization",
    "data-minimization"
  ],
  "author": "Catalina Toledo, María Gerónimo, Pablo Lineros, Fabián Salinas",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  }
}
